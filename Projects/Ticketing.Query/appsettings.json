{
  "ConnectionStrings": {
    "PostgresConnectionString": "Host=localhost;Port=5432;Database=cleanarchitecture;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConsumerConfig": {
    "GroupId": "TK_CONSUMER",
    "BootstrapServers": "localhost:29092",
    "EnableAutoCommit": false,
    "AutoOffsetReset": "Earliest",
    "AllowAutoCreateTopics": true
  },
  "KafkaSettings": {
    // MEJORA: El topic ya no está hardcodeado en el código.
    // Cámbialo aquí sin necesidad de recompilar la aplicación.
    // En producción, sobreescríbelo con una variable de entorno:
    //   KafkaSettings__TopicName=mi-topic-productivo
    "TopicName": "TICKET_EVENTS"
  }
}
